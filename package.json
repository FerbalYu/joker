{
  "name": "joker",
  "version": "0.1.1",
  "private": true,
  "description": "JOKER — AI coding agent desktop app",
  "homepage": "https://example.invalid/joker",
  "author": {
    "name": "JOKER",
    "email": "maintainers@example.invalid"
  },
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "npm run test:unit",
    "test:unit": "node scripts/run-tests.mjs",
    "test:integration": "node scripts/run-tests.mjs --integration",
    "test:integration:mcp": "node --test --import=tsx src/main/mcp/client.integration.test.ts",
    "test:web:contract": "node --test --import=tsx src/main/tools/web.integration.test.ts",
    "test:e2e:electron": "npm run build && node scripts/electron-smoke.mjs",
    "test:e2e:electron:approval": "npm run build && node scripts/electron-approval-smoke.mjs",
    "test:e2e:electron:research": "npm run build && node scripts/electron-deep-research-smoke.mjs",
    "test:e2e:electron:tool-groups": "npm run build && node scripts/electron-tool-group-smoke.mjs",
    "test:e2e:electron:queue-steer": "npm run build && node scripts/electron-queue-steer-smoke.mjs",
    "test:e2e:electron:multi-session": "npm run build && node scripts/electron-multi-session-concurrency-smoke.mjs",
    "test:e2e:electron:image-attachments": "npm run build && node scripts/electron-image-attachment-smoke.mjs",
    "test:e2e:electron:generated-image": "npm run build && node scripts/electron-generated-image-smoke.mjs",
    "test:e2e:electron:file-context-menu": "npm run build && node scripts/electron-file-context-menu-smoke.mjs",
    "test:e2e:electron:subagent-observability": "npm run build && node scripts/electron-subagent-observability-smoke.mjs",
    "test:e2e:electron:mcp-settings": "npm run build && node scripts/electron-mcp-settings-smoke.mjs",
    "test:e2e:electron:generated-tools-settings": "npm run build && node scripts/electron-generated-tools-settings-smoke.mjs",
    "test:e2e:electron:toolforge-vertical-slice": "npm run build && node scripts/electron-toolforge-vertical-slice-smoke.mjs",
    "test:e2e:electron:toolforge-fresh-profile": "npm run build && node scripts/electron-toolforge-fresh-profile-smoke.mjs",
    "test:qualification:toolforge-fresh-profile-package": "node scripts/packaged-toolforge-fresh-profile-smoke.mjs",
    "test:e2e:electron:toolforge-edit": "npm run build && node scripts/electron-toolforge-edit-smoke.mjs",
    "test:e2e:electron:toolforge-edit-failure": "npm run build && node scripts/electron-toolforge-edit-smoke.mjs --failure",
    "test:qualification:stream": "npm run build && node scripts/electron-stream-soak.mjs",
    "test:qualification:renderer-stream": "npm run build && node scripts/electron-renderer-stream-performance.mjs",
    "test:qualification:release-boundaries": "node scripts/release-boundary-audit.mjs",
    "test:qualification:session-concurrency": "node --import=tsx scripts/session-concurrency-qualification.mjs",
    "test:qualification:mcp": "node --import=tsx scripts/mcp-boundary-qualification.mjs",
    "test:qualification:native-package": "node scripts/native-package-qualification.mjs",
    "test:qualification:context-optimization": "node --import=tsx scripts/context-optimization-qualification.mjs",
    "test:qualification:runtime": "node --import=tsx scripts/runtime-qualification.mjs",
    "test:qualification:toolforge-persistence": "node --import=tsx scripts/toolforge-persistence-qualification.mjs",
    "test:qualification:toolforge-package": "node scripts/packaged-toolforge-qualification.mjs",
    "test:qualification:toolforge-fixture-package": "node scripts/packaged-toolforge-fixture-qualification.mjs",
    "test:qualification:toolforge-gate2": "node --import=tsx scripts/toolforge-gate2-qualification.mjs",
    "test:qualification:toolforge-gate2-package": "node scripts/packaged-toolforge-gate2-qualification.mjs",
    "test:qualification:toolforge-gate4-package": "node scripts/packaged-toolforge-gate4-edit-qualification.mjs",
    "test:qualification:toolforge-vertical-slice": "node --import=tsx scripts/toolforge-vertical-slice.mjs",
    "test:qualification:toolforge-concurrent-edit": "node scripts/toolforge-concurrent-edit-qualification.mjs",
    "test:e2e:electron:context-optimization": "npm run build && node scripts/electron-context-optimization-smoke.mjs",
    "test:qualification:signed-release": "node scripts/signed-release-qualification.mjs",
    "test:qualification:gate5-audit": "node --import=tsx scripts/gate5-audit.mjs",
    "test:qualification:bundle": "node --import=tsx scripts/qualification-bundle.mjs",
    "test:coverage": "node scripts/run-tests.mjs --coverage",
    "lint": "node scripts/lint.mjs",
    "check": "npm run lint && npm run typecheck && node --check scripts/lint.mjs && node --check scripts/run-tests.mjs && node --check scripts/runtime-qualification.mjs && node --check scripts/release-provenance.mjs && node --check scripts/toolforge-persistence-qualification.mjs && node --check scripts/toolforge-gate2-qualification.mjs && node --check scripts/fixtures/toolforge-persistence-worker.mjs && node --check scripts/packaged-toolforge-qualification.mjs && node --check scripts/packaged-toolforge-fixture-qualification.mjs && node --check scripts/packaged-toolforge-gate2-qualification.mjs && node --check scripts/packaged-toolforge-gate4-edit-qualification.mjs && node --check scripts/electron-generated-tools-settings-smoke.mjs && node --check scripts/fixtures/runtime-qualification-suite.mjs && npm run test:unit && npm run test:integration",
    "build:dist": "npm run build && electron-builder",
    "build:dist:unsigned": "npm run build && electron-builder --config electron-builder.unsigned.yml"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.18",
    "@ai-sdk/openai": "^4.0.20",
    "@ai-sdk/openai-compatible": "^3.0.14",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "ajv": "^8.20.0",
    "ai": "^7.0.36",
    "diff": "^9.0.0",
    "echarts": "^6.1.0",
    "lucide-react": "^1.26.0",
    "p-limit": "^7.1.0",
    "playwright-core": "^1.62.0",
    "quickjs-emscripten": "^0.32.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.34.5",
    "zod": "^4.1.5",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/diff": "^7.0.2",
    "@types/node": "^22.10.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^43.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "postcss": "^8.4.49",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^5.7.3",
    "vite": "^5.4.11"
  }
}
